{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/onboard", "destination": "/onboard.html" },
