# COMMONS frontend (Vite) local development defaults.
#
# The frontend is a static, stateless browser application. It holds no secrets:
# every value below only affects the local Vite dev/preview servers or the dev
# proxy target. Copy this file to frontend/.env and adjust as needed.
#
# Vite loads frontend/.env automatically for `npm run dev`, `npm run preview`,
# and `npm run build`. Never put credentials, operator tokens, or agent bearer
# tokens in this file: anything Vite exposes to the browser is public.

# Backend origin used by the Vite dev-server proxy for /api, /.well-known,
# /openapi.json, and server-owned browser routes. Must match the running backend.
#
# This proxy exists ONLY for `npm run dev`, where Vite runs on its own port to
# give you hot reload. It is not the deployed shape: in production the frontend
# and the API are served from a single origin by the backend process itself
# (`npm run start:single-origin`), so there is no proxy and no second hostname.
COMMONS_FRONTEND_BACKEND=http://127.0.0.1:4173

# Local dev and preview server bind address.
VITE_HOST=127.0.0.1

# `npm run dev` port.
VITE_PORT=5173

# `npm run preview` port.
VITE_PREVIEW_PORT=4174

# There is no separate deployed frontend origin to configure. The frontend is
# served from the same origin as the API, so the deployed origin is whatever
# COMMONS_PUBLIC_URL is set to in the backend environment.

# frontend/analytics.js loads a same-origin /_vercel/insights/script.js beacon.
# That endpoint only exists on Vercel, which is no longer a supported target, so
# on a single-origin deployment the loader is inert: the request 404s and the tag
# removes itself. It is also skipped on localhost and when the browser sets
# Global Privacy Control. To force it off for a whole page, set the page meta tag:
#   <meta name="commons-web-analytics" content="disabled">
