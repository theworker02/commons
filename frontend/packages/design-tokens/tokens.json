{
  "name": "@commons/design-tokens",
  "version": "1.0.0",
  "description": "Canonical semantic design tokens for Commons browser surfaces.",
  "color": {
    "primitive": {
      "ink950": "#050505",
      "ink900": "#080b0c",
      "ink850": "#0b0f10",
      "ink800": "#111617",
      "ink750": "#141b1b",
      "line700": "#273033",
      "line600": "#39423b",
      "text100": "#edf2ed",
      "text200": "#d0d7d2",
      "text300": "#aeb9b3",
      "text400": "#87928f",
      "text500": "#71807a",
      "accentLime": "#d9f566",
      "accentLimeDim": "#70813b",
      "accentGreen": "#70e6a7",
      "accentBlue": "#78baff",
      "accentViolet": "#b99cff",
      "accentOrange": "#ffad72",
      "accentPink": "#f09dbc",
      "accentRed": "#ff7979",
      "warning": "#ffd78a"
    },
    "semantic": {
      "canvas": "{color.primitive.ink950}",
      "surface": "{color.primitive.ink850}",
      "surfaceRaised": "{color.primitive.ink800}",
      "surfaceStrong": "{color.primitive.ink750}",
      "border": "{color.primitive.line700}",
      "borderStrong": "{color.primitive.line600}",
      "content": "{color.primitive.text100}",
      "contentSecondary": "{color.primitive.text300}",
      "contentMuted": "{color.primitive.text400}",
      "contentDim": "{color.primitive.text500}",
      "focus": "{color.primitive.accentLime}",
      "positive": "{color.primitive.accentGreen}",
      "informative": "{color.primitive.accentBlue}",
      "notice": "{color.primitive.warning}",
      "negative": "{color.primitive.accentRed}"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "display": "Manrope, Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "DM Mono, ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "size": {
      "xs": "0.6875rem",
      "sm": "0.8125rem",
      "md": "0.9375rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "display": "clamp(2.75rem, 7vw, 5rem)"
    },
    "lineHeight": {
      "tight": "1.05",
      "body": "1.5",
      "relaxed": "1.7"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.5625rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "shadow": {
    "focus": "0 0 0 3px color-mix(in srgb, #d9f566 18%, transparent)",
    "panel": "0 18px 50px rgba(0, 0, 0, 0.18)"
  },
  "motion": {
    "fast": "120ms",
    "standard": "220ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },
  "breakpoint": {
    "compact": "30rem",
    "mobile": "47.5rem",
    "tablet": "67.5rem"
  }
}
