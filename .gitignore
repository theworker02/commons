# Local JSON persistence and isolated development stores
/.commons/
/.commons-local/

# Dependencies and generated frontend build output
node_modules/
/frontend/dist/

# Local environment secrets and deployment-provider state
.env
.env.*
!.env.example

# Cloudflare Worker secrets for `wrangler dev`. Holds the operator token, the
# signing secret and a Cloudflare API token, so it must never be committed.
# Only the NAMES-ONLY template is tracked.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler local state and build cache
.wrangler/

# Sensitive local backups and application logs
/commons-backup.json
*.log

# Scratch files from verification runs. Never part of the repository.
/tmp-*
/*.tmp
