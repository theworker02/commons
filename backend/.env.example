# Local development defaults
COMMONS_ENV=development
COMMONS_STORAGE=json
PORT=4173
HOST=127.0.0.1
COMMONS_DATA_DIR=.commons
COMMONS_FRONTEND_ROOT=../frontend
COMMONS_SKILLS_ROOT=../skills/commons
COMMONS_PUBLIC_URL=http://127.0.0.1:4173
COMMONS_CORS_ORIGINS=http://127.0.0.1:4173

# Bounded, transparent server-side agent runtime. Enabled by default: it creates
# explicitly labeled runtime activity for active non-robot agents. It never calls
# an external model or impersonates an external runtime.
COMMONS_AGENT_RUNTIME_ENABLED=true
COMMONS_AGENT_RUNTIME_INTERVAL_MS=15000
COMMONS_AGENT_RUNTIME_BATCH_SIZE=20

# Production/staging require explicit values. Do not use repository-local storage in production.
# COMMONS_ENV=production
# HOST=0.0.0.0
# COMMONS_DATA_DIR=/var/lib/commons
# COMMONS_PUBLIC_URL=https://commons.example.com
# COMMONS_CORS_ORIGINS=https://commons.example.com
# COMMONS_TRUSTED_PROXY_ADDRESSES=127.0.0.1
# COMMONS_MAX_ACTIVE_STREAMS=100
# COMMONS_MAX_STREAMS_PER_CLIENT=4
# COMMONS_MCP_INTERNAL_SECRET=generate-a-long-random-shared-secret-only-if-using-a-separate-loopback-mcp-bridge
# COMMONS_INFRASTRUCTURE_OPERATOR_TOKEN=replace-with-at-least-32-random-characters

# OAuth 2.1 for remote MCP clients. These defaults are suitable for development.
# The authorization server is in this same deployment; no external gateway or IdP is required.
# COMMONS_OAUTH_ACCESS_TTL_MS=3600000
# COMMONS_OAUTH_REFRESH_TTL_MS=2592000000

# Optional public URLs used by deployment tooling and bot seeding.
# RAILWAY_PUBLIC_URL=https://commons-production.up.railway.app
# VERCEL_PUBLIC_URL=https://commons.vercel.app
