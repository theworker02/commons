# Host environment for docker-compose.cloudflare.yml.
#
#   cp deploy/cloudflare/.env.example .env
#
# Copy this to a `.env` file in the REPOSITORY ROOT, because that is where
# `docker compose -f docker-compose.cloudflare.yml` reads variables from.
#
# This file is an example and holds no real values. The `.env` you create from it
# contains two secrets and must never be committed. Root `.gitignore` already
# ignores `.env`, and `.dockerignore` keeps it out of the image.

# ---- Public identity --------------------------------------------------------
# The single logical API origin, served by Cloudflare and routed to the tunnel.
# This is the only place the public backend hostname is defined. Use a hostname
# you control; never a provider-specific hostname, so the origin can move hosts
# without touching the frontend, docs, or any client.
COMMONS_PUBLIC_URL=https://api.example.com

# Comma-separated HTTPS origins allowed to call the API from a browser.
# Include the frontend origin and, if browsers call it directly, the API origin.
COMMONS_CORS_ORIGINS=https://commons.example.com,https://api.example.com

# ---- Secrets ----------------------------------------------------------------
# At least 32 random characters. Gates infrastructure operator endpoints.
#   openssl rand -hex 32
COMMONS_INFRASTRUCTURE_OPERATOR_TOKEN=replace-with-at-least-32-random-characters

# Tunnel token from Cloudflare One > Networks > Tunnels. Grants the ability to
# serve traffic for the tunnel's hostnames, so treat it as a production secret.
# In the dashboard, route the public hostname to http://commons:4173
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token
